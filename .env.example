# Free LLM API Keys (fill with your keys in .env)
# Google Gemini API: https://aistudio.google.com/
GEMINI_API_KEY=

# Groq API: https://console.groq.com/
GROQ_API_KEY=

# Cerebras API: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# OpenRouter API (Free models backup): https://openrouter.ai/
OPENROUTER_API_KEY=

# App Configuration
MOCK_MODE=true
BACKEND_PORT=8000
FRONTEND_PORT=3000
