      "total_steps": 5,
      "concept": "Recursion & Trees",
      "narration": "Spot on! Now let's assemble the complete Python algorithm. Notice our loop condition: while low <= high. Inside, we compute mid, check for match, and shift low or high. Let's run the code live in our browser Python runtime to see every step printed out!",
      "board_commands": [
        {
          "type": "text",
          "id": "algo_title",
          "content": "Full Binary Search Algorithm",
          "x": 60.0,
          "y": 50.0,
          "size": 22,
          "color": "#0f172a"
        },
        {
          "type": "equation",
          "id": "eq_recurrence",
          "latex": "T(n) = T\\left(\\frac{n}{2}\\right) + \\mathcal{O}(1) = \\mathcal{O}(\\log n)",
          "x": 60.0,
          "y": 110.0,
          "label": "Recurrence Relation"
        },
        {
          "type": "mermaid",
          "id": "chart_steps",
          "chart": "graph TD\n  Start[low=0, high=9] --> Step1[mid=4, val=16 < 23]\n  Step1 --> Step2[low=5, high=9, mid=7, val=56 > 23]\n  Step2 --> Step3[low=5, high=6, mid=5, val=23 == 23]\n  Step3 --> Found[Target Found at Index 5!]",
          "x": 60.0,
          "y": 180.0,
          "title": "Execution Path for Target 23"
        }
      ],
      "code_action": {
        "code": "def binary_search(arr, target):\n    low = 0\n    high = len(arr) - 1\n    \n    while low <= high:\n        mid = (low + high) // 2\n        val = arr[mid]\n        print(f'Checking range [{low}..{high}], mid={mid}, val={val}')\n        \n        if val == target:\n            return mid\n        elif val < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return -1\n\n# Demo run\nnumbers = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]\ntarget = 23\nidx = binary_search(numbers, target)\nprint(f'Target {target} located at index: {idx}')\n",
        "language": "python",
        "action": "execute",
        "explanation": "Iterative Binary Search with time complexity O(log n) and space complexity O(1)."
      },
      "code_chunks": [
